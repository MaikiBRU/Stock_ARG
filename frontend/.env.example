# Copiar a .env.local. Este archivo es una plantilla.

# En desarrollo conviene "localhost" y no "127.0.0.1": la cookie de
# sesion es SameSite=Lax, y localhost:3000 con localhost:8000 son el
# mismo sitio, mientras que 127.0.0.1 es otro.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional: habilita "Continuar con Google" (RF-A06). Es el client id
# web de Google, que es publico; el secreto nunca va en el frontend.
# Sin esta variable el boton no aparece.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
