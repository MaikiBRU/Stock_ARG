# Bloque para /etc/caddy/Caddyfile del servidor. Caddy corre como
# servicio del sistema y resuelve el certificado solo; la API escucha en
# 127.0.0.1:8002 y nunca queda expuesta de forma directa.

api-stockarg.aaronbrumat.com.ar {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8002

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
