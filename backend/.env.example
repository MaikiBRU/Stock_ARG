# Copiar a backend/.env y completar. Este archivo es una plantilla:
# nunca debe contener valores reales.

ENVIRONMENT=development

# Obligatoria y sin valor por defecto. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=postgresql+psycopg://stockarg:stockarg@127.0.0.1:5432/stockarg

ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_URL=http://127.0.0.1:3000

# Zona del comercio: decide que dia es "hoy" en el panel y los reportes.
ZONA_HORARIA=America/Argentina/Buenos_Aires

# Envio de correo para la verificacion de cuenta (RF-A01).
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@stockarg.local

# Ingreso con Google (RF-A03).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Demo publica (modulo J). En false, /demo/* responde 404 y los tokens
# de demo ya emitidos dejan de valer.
DEMO_ENABLED=true
DEMO_SESSION_TTL_MINUTES=45
DEMO_IDLE_TIMEOUT_MINUTES=20
DEMO_MAX_ACTIVE_SESSIONS=200
DEMO_RATE_LIMIT_PER_HOUR=12
# 0 apaga la limpieza en segundo plano.
DEMO_CLEANUP_INTERVAL_SECONDS=300
# Sin valor, la limpieza manual responde 404. Generar igual que SECRET_KEY.
DEMO_MAINTENANCE_TOKEN=
DEMO_MAX_PRODUCTOS=300
DEMO_MAX_VENTAS=800
DEMO_MAX_IMPORTACIONES=15
DEMO_MAX_EXPORTACIONES=40
