# Copiar a backend/.env y completar. Este archivo es una plantilla:
# nunca debe contener valores reales.

ENVIRONMENT=development

# Obligatoria y sin valor por defecto. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=postgresql+psycopg://stockarg:stockarg@127.0.0.1:5432/stockarg

ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_URL=http://127.0.0.1:3000

# Envio de correo para la verificacion de cuenta (RF-A01).
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@stockarg.local

# Ingreso con Google (RF-A03).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Demo publica (modulo J).
DEMO_ENABLED=true
DEMO_MAINTENANCE_TOKEN=
